{
  "manifest_version": 3,
  "name": "Soften Extension",
  "version": "1.0",
  "description": "웹 페이지를 부드럽게 만들어주는 확장 프로그램",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
} 